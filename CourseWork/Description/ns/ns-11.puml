@startuml
title "Негативный сценарий 11. Связь. Нарушение ЦБ-1, ЦБ-3, ЦБ-5"

autonumber
participant "8. WMS" as wms
participant "1. Связь" as conn #red
participant "2. Система\nуправления\nроботом" as ctrl
participant "5. Система координации\n(QR-коды)" as qr
participant "6. Доп. система\nкоординации\n(Лидары)" as lidar
participant "7. Система\nпередвижения" as move
participant "4. Система\nзахвата" as grip

group Получение задачи
wms -> conn: команда доставки
conn -[#red]> conn: сбой / ошибка в данных
conn -[#red]> ctrl: неверный маршрут\nили координаты
note over conn, qr
  Ошибка в карте маршрутов,
  сбой навигации или вредоносная команда.
end note
end

group Движение по неверному маршруту
ctrl -> ctrl: расчёт маршрута
ctrl <- qr: координаты (некорректные)
ctrl <- lidar: расстояние
ctrl -> move: движение
ctrl -> grip: захват стеллажа
grip -> ctrl: захват выполнен
end

group #red Выезд за пределы зоны
ctrl -> move: движение за пределы\nавторизованной секции
move -> move: выезд к выходу\nили за периметр склада
note over ctrl, move
  Робот с грузом покидает
  авторизованную зону склада.
end note
end

note over conn, move #FFCCCC
  Груз вывезен за пределы зоны.
  Нарушение ЦБ-1, ЦБ-3, ЦБ-5.
end note
@enduml
