        <mxCell id="_wh1W9CfjywFpe7uXpXx-96" parent="_wh1W9CfjywFpe7uXpXx-2" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1">
          <mxGeometry height="80" width="710" y="1170" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-97" parent="_wh1W9CfjywFpe7uXpXx-96" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="14. Модуль контроля захвата груза" vertex="1">
          <mxGeometry height="80" width="140" as="geometry">
            <mxRectangle height="80" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-98" parent="_wh1W9CfjywFpe7uXpXx-96" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;span style=&quot;text-align: justify;&quot;&gt;Управляет механизмом подъёма и фиксации стеллажа. Отвечает&lt;/span&gt;&lt;br style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;text-align: justify;&quot;&gt;за точное позиционирование под стеллажом, корректный захват, подъём и удержание&lt;/span&gt;&lt;br style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;text-align: justify;&quot;&gt;груза во время транспортировки.&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="570" x="140" as="geometry">
            <mxRectangle height="80" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-99" parent="_wh1W9CfjywFpe7uXpXx-2" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1">
          <mxGeometry height="80" width="710" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-100" parent="_wh1W9CfjywFpe7uXpXx-99" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="15. Контроллер зарядки" vertex="1">
          <mxGeometry height="80" width="140" as="geometry">
            <mxRectangle height="80" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-101" parent="_wh1W9CfjywFpe7uXpXx-99" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="Управляет процессом стыковки к подзарядной станции, а также за само состояние батареи. Данные передает в модуль контроля состояния заряда." vertex="1">
          <mxGeometry height="80" width="570" x="140" as="geometry">
            <mxRectangle height="80" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-102" parent="_wh1W9CfjywFpe7uXpXx-2" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1">
          <mxGeometry height="80" width="710" y="1330" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-103" parent="_wh1W9CfjywFpe7uXpXx-102" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="16. Модуль контроля состояния заряда" vertex="1">
          <mxGeometry height="80" width="140" as="geometry">
            <mxRectangle height="80" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-104" parent="_wh1W9CfjywFpe7uXpXx-102" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;Отвечает за валидацию состояния батареи. Проверяет чтобы не было больших скачков в процентах заряда за небольшой промежуток времени, а также определение момента, когда роботу требуется на базу для подзарядки.&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="570" x="140" as="geometry">
            <mxRectangle height="80" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-105" parent="_wh1W9CfjywFpe7uXpXx-2" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1">
          <mxGeometry height="80" width="710" y="1410" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-106" parent="_wh1W9CfjywFpe7uXpXx-105" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="17. Модуль самодиагностики" vertex="1">
          <mxGeometry height="80" width="140" as="geometry">
            <mxRectangle height="80" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-107" parent="_wh1W9CfjywFpe7uXpXx-105" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Отвечает за сбор всех данных от валидирующих модулей и передачу их в центральную систему управления дроном.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="570" x="140" as="geometry">
            <mxRectangle height="80" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-43" parent="Z18iUcD2hyG3G0yn-TbN-1" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;" value="" vertex="1">
          <mxGeometry height="750" width="710" x="90" y="-1160" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-44" parent="_wh1W9CfjywFpe7uXpXx-43" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1">
          <mxGeometry height="40" width="710" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-45" parent="_wh1W9CfjywFpe7uXpXx-44" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="Название" vertex="1">
          <mxGeometry height="40" width="140" as="geometry">
            <mxRectangle height="40" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-46" parent="_wh1W9CfjywFpe7uXpXx-44" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="Назначение" vertex="1">
          <mxGeometry height="40" width="570" x="140" as="geometry">
            <mxRectangle height="40" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-47" parent="_wh1W9CfjywFpe7uXpXx-43" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="60" width="710" y="40" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-48" parent="_wh1W9CfjywFpe7uXpXx-47" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="1. Модуль связи" vertex="1">
          <mxGeometry height="60" width="140" as="geometry">
            <mxRectangle height="60" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-49" parent="_wh1W9CfjywFpe7uXpXx-47" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;p class=&quot;MsoNormal&quot;&gt;&lt;/p&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Отвечает за обмен данными с центральной системой управления&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;складом. Принимает команды (например, «привезти стеллаж X»), отправляет статусы&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;о выполнении, уровне заряда и любых нештатных ситуациях.&lt;/span&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="570" x="140" as="geometry">
            <mxRectangle height="60" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-53" parent="_wh1W9CfjywFpe7uXpXx-43" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="100" width="710" y="100" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-54" parent="_wh1W9CfjywFpe7uXpXx-53" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;p class=&quot;MsoNormal&quot;&gt;2. Система управления роботом&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="140" as="geometry">
            <mxRectangle height="100" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-55" parent="_wh1W9CfjywFpe7uXpXx-53" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;p style=&quot;&quot; class=&quot;MsoNormal&quot;&gt;&lt;/p&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Получает задачи от модуля связи, интерпретирует их и&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;координирует работу всех исполнительных подсистем. Принимает решения на основе&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;данных от систем координации и диагностики, управляет движением, захватом и&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;зарядкой.&lt;/span&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="570" x="140" as="geometry">
            <mxRectangle height="100" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-56" parent="_wh1W9CfjywFpe7uXpXx-43" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="90" width="710" y="200" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-57" parent="_wh1W9CfjywFpe7uXpXx-56" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;p class=&quot;MsoNormal&quot;&gt;3. Модуль заряда&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="140" as="geometry">
            <mxRectangle height="90" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-58" parent="_wh1W9CfjywFpe7uXpXx-56" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;p style=&quot;&quot; class=&quot;MsoNormal&quot;&gt;&lt;/p&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Отвечает за автоматическое определение момента, когда роботу&lt;/span&gt;&lt;/div&gt;требуется подзарядка. Управляет наведением на зарядную станцию, стыковкой и&lt;br&gt;процессом зарядки. Передаёт статус зарядки в систему управления роботом.&lt;p&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="570" x="140" as="geometry">
            <mxRectangle height="90" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-59" parent="_wh1W9CfjywFpe7uXpXx-43" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="60" width="710" y="290" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-60" parent="_wh1W9CfjywFpe7uXpXx-59" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;p class=&quot;MsoNormal&quot;&gt;4. Система захвата&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="140" as="geometry">
            <mxRectangle height="60" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-61" parent="_wh1W9CfjywFpe7uXpXx-59" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;p style=&quot;&quot; class=&quot;MsoNormal&quot;&gt;Управляет механизмом подъёма и фиксации стеллажа. Отвечает&lt;br&gt;за точное позиционирование под стеллажом, корректный захват, подъём и удержание&lt;br&gt;груза во время транспортировки.&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="570" x="140" as="geometry">
            <mxRectangle height="60" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-62" parent="_wh1W9CfjywFpe7uXpXx-43" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="80" width="710" y="350" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-63" parent="_wh1W9CfjywFpe7uXpXx-62" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;p class=&quot;MsoNormal&quot;&gt;5. Система координации (QR-коды с пола)&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="140" as="geometry">
            <mxRectangle height="80" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-64" parent="_wh1W9CfjywFpe7uXpXx-62" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;p style=&quot;&quot; class=&quot;MsoNormal&quot;&gt;Основная навигационная подсистема. Считывает QR-коды,&lt;br&gt;нанесённые на полу склада, для определения точного местоположения робота.&lt;br&gt;Позволяет следовать по заданному маршруту с высокой точностью и подтверждать&lt;br&gt;прибытие в нужную точку (стеллаж, станция, зарядка).&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="570" x="140" as="geometry">
            <mxRectangle height="80" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-65" parent="_wh1W9CfjywFpe7uXpXx-43" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="80" width="710" y="430" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-66" parent="_wh1W9CfjywFpe7uXpXx-65" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;p class=&quot;MsoNormal&quot;&gt;6. Доп. система координации (Лидары)&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="140" as="geometry">
            <mxRectangle height="80" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-67" parent="_wh1W9CfjywFpe7uXpXx-65" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;p style=&quot;&quot; class=&quot;MsoNormal&quot;&gt;Вспомогательная навигационная подсистема. Использует боковые&lt;br&gt;датчики (лидары) для контроля расстояния до стеллажей и стен. Обеспечивает&lt;br&gt;безопасное движение в узких проходах и точную корректировку положения при&lt;br&gt;подъезде к стеллажу или станции.&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="570" x="140" as="geometry">
            <mxRectangle height="80" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-68" parent="_wh1W9CfjywFpe7uXpXx-43" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="80" width="710" y="510" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-69" parent="_wh1W9CfjywFpe7uXpXx-68" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;p class=&quot;MsoNormal&quot;&gt;7. Система передвижения&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="140" as="geometry">
            <mxRectangle height="80" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-70" parent="_wh1W9CfjywFpe7uXpXx-68" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;p style=&quot;&quot; class=&quot;MsoNormal&quot;&gt;Преобразует команды от системы управления роботом в сигналы&lt;br&gt;для моторов колёс. Отвечает за плавный старт и остановку, соблюдение&lt;br&gt;скоростного режима, повороты и торможение. Взаимодействует с системами&lt;br&gt;координации для точного следования маршруту.&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="570" x="140" as="geometry">
            <mxRectangle height="80" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-71" parent="_wh1W9CfjywFpe7uXpXx-43" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="80" width="710" y="590" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-72" parent="_wh1W9CfjywFpe7uXpXx-71" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;p class=&quot;MsoNormal&quot;&gt;8. Cистема управления складом (WMS)&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="140" as="geometry">
