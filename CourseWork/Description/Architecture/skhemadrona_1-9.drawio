          <mxGeometry height="80" width="710" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-88" parent="_wh1W9CfjywFpe7uXpXx-87" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="12. Управление приводами" vertex="1">
          <mxGeometry height="80" width="140" as="geometry">
            <mxRectangle height="80" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-89" parent="_wh1W9CfjywFpe7uXpXx-87" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Отвечает за работу колес дрона при соотвтествующей команде от центральной системы управления дроном.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="570" x="140" as="geometry">
            <mxRectangle height="80" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-84" parent="_wh1W9CfjywFpe7uXpXx-2" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1">
