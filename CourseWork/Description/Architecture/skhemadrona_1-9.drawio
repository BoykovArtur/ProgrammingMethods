        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-85" parent="_wh1W9CfjywFpe7uXpXx-84" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="13. Манипуляторы" vertex="1">
          <mxGeometry height="80" width="140" as="geometry">
            <mxRectangle height="80" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-86" parent="_wh1W9CfjywFpe7uXpXx-84" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="Отвечает за захват стеллажа или его опускание при соответсвующей команде от модуля контроля захвата груза." vertex="1">
          <mxGeometry height="80" width="570" x="140" as="geometry">
