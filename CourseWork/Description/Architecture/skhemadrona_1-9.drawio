          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-9" parent="_wh1W9CfjywFpe7uXpXx-2" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="90" width="710" y="260" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-10" parent="_wh1W9CfjywFpe7uXpXx-9" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;p class=&quot;MsoNormal&quot;&gt;4. Оркестратор процесса доставки&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="140" as="geometry">
            <mxRectangle height="90" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-11" parent="_wh1W9CfjywFpe7uXpXx-9" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;p style=&quot;text-align: justify;&quot; class=&quot;MsoNormal&quot;&gt;Главный компонент центральной системы управления дроном. Отвечает за весь процесс выполнения задания. Координирует работу всех исполнительных подсистем. Принимает решение на основе данных от системы навигации, модулей самодиагностики и контроля состояния заряда.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="570" x="140" as="geometry">
            <mxRectangle height="90" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-12" parent="_wh1W9CfjywFpe7uXpXx-2" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="100" width="710" y="350" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-13" parent="_wh1W9CfjywFpe7uXpXx-12" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;p class=&quot;MsoNormal&quot;&gt;5. Система навигации&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="140" as="geometry">
            <mxRectangle height="100" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-14" parent="_wh1W9CfjywFpe7uXpXx-12" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;p style=&quot;text-align: justify;&quot; class=&quot;MsoNormal&quot;&gt;Отвечает за обработку данных между подсистемами координации (лидары и QR-коды) и центральной системой управления дроном. Данные от валидирующих подмодулей отправляются в оркестратор процесса доставки для дальнейшего принятия действий. (А еще данные идут от оркестратора до этих самых модулей, чтобы им было с чем сравнивать).&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="570" x="140" as="geometry">
            <mxRectangle height="100" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-15" parent="_wh1W9CfjywFpe7uXpXx-2" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="80" width="710" y="450" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-16" parent="_wh1W9CfjywFpe7uXpXx-15" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;p class=&quot;MsoNormal&quot;&gt;6. Модуль управления захватом&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="140" as="geometry">
            <mxRectangle height="80" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-17" parent="_wh1W9CfjywFpe7uXpXx-15" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;p style=&quot;text-align: justify;&quot; class=&quot;MsoNormal&quot;&gt;Отвечает за выполнение захвата груза. После получения команды от оркестратора процесса доставки передает задание в соответствующую подсистему.&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="570" x="140" as="geometry">
            <mxRectangle height="80" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-18" parent="_wh1W9CfjywFpe7uXpXx-2" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="80" width="710" y="530" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-19" parent="_wh1W9CfjywFpe7uXpXx-18" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;p class=&quot;MsoNormal&quot;&gt;7. Модуль аварийного торможения&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="140" as="geometry">
            <mxRectangle height="80" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-20" parent="_wh1W9CfjywFpe7uXpXx-18" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;p style=&quot;text-align: justify;&quot; class=&quot;MsoNormal&quot;&gt;Отвечает за подачу команды перемещения или эстренное аварийное торможение дрона при соответствующем запросе оркестратора процесса доставки.&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="570" x="140" as="geometry">
            <mxRectangle height="80" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-21" parent="_wh1W9CfjywFpe7uXpXx-2" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="80" width="710" y="610" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-22" parent="_wh1W9CfjywFpe7uXpXx-21" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;p class=&quot;MsoNormal&quot;&gt;7. Камеры&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="140" as="geometry">
            <mxRectangle height="80" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-23" parent="_wh1W9CfjywFpe7uXpXx-21" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;p style=&quot;text-align: justify;&quot; class=&quot;MsoNormal&quot;&gt;Отвечают за создание фото, которые далее будут проанализированны модулем распознания QR-кодов.&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="570" x="140" as="geometry">
            <mxRectangle height="80" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-24" parent="_wh1W9CfjywFpe7uXpXx-2" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="80" width="710" y="690" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-25" parent="_wh1W9CfjywFpe7uXpXx-24" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;p class=&quot;MsoNormal&quot;&gt;8. Модуль распознавания QR-кода&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="140" as="geometry">
            <mxRectangle height="80" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-26" parent="_wh1W9CfjywFpe7uXpXx-24" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;p style=&quot;text-align: justify;&quot; class=&quot;MsoNormal&quot;&gt;Отвечает за анализ данных от камеры и определение точного положения робота через обнаруженные QR-коды. Результаты отправляет в модуль валидации.&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="570" x="140" as="geometry">
            <mxRectangle height="80" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-27" parent="_wh1W9CfjywFpe7uXpXx-2" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" value="" vertex="1">
          <mxGeometry height="80" width="710" y="770" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-28" parent="_wh1W9CfjywFpe7uXpXx-27" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="&lt;p class=&quot;MsoNormal&quot;&gt;9. Модуль валидации считывания QR-кода&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="140" as="geometry">
            <mxRectangle height="80" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-29" parent="_wh1W9CfjywFpe7uXpXx-27" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;div style=&quot;&quot;&gt;&lt;p style=&quot;text-align: justify;&quot; class=&quot;MsoNormal&quot;&gt;Отвечает за проверку координат от модуля распознания и системы навигации, чтобы не было несостыковок.&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="570" x="140" as="geometry">
            <mxRectangle height="80" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-93" parent="_wh1W9CfjywFpe7uXpXx-2" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1">
          <mxGeometry height="80" width="710" y="850" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-94" parent="_wh1W9CfjywFpe7uXpXx-93" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="10. Лидары" vertex="1">
          <mxGeometry height="80" width="140" as="geometry">
            <mxRectangle height="80" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-95" parent="_wh1W9CfjywFpe7uXpXx-93" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;span style=&quot;text-align: justify;&quot;&gt;Вспомогательная навигационная подсистема. Использует боковые&lt;/span&gt;&lt;br style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;text-align: justify;&quot;&gt;датчики (лидары) для контроля расстояния до стеллажей и стен. Обеспечивает&lt;/span&gt;&lt;br style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;text-align: justify;&quot;&gt;безопасное движение в узких проходах и точную корректировку положения при&lt;/span&gt;&lt;br style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;text-align: justify;&quot;&gt;подъезде к стеллажу или станции.&lt;/span&gt;" vertex="1">
          <mxGeometry height="80" width="570" x="140" as="geometry">
            <mxRectangle height="80" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-90" parent="_wh1W9CfjywFpe7uXpXx-2" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" vertex="1">
          <mxGeometry height="80" width="710" y="930" as="geometry" />
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-91" parent="_wh1W9CfjywFpe7uXpXx-90" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" value="11. Модуль контроля состояния лидаров" vertex="1">
          <mxGeometry height="80" width="140" as="geometry">
            <mxRectangle height="80" width="140" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="_wh1W9CfjywFpe7uXpXx-92" parent="_wh1W9CfjywFpe7uXpXx-90" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;Отвечает за проверку корректности работы лидаров методом большинства (не помню что тут как именно).&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="570" x="140" as="geometry">
            <mxRectangle height="80" width="570" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
